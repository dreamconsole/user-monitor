{
  "name": "user-monitor-agent",
  "productName": "User Monitor Agent",
  "version": "1.2.21",
  "description": "Desktop Agent for User Activity Monitoring",
  "main": "src/main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "dev": "electron . --no-sandbox",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:sqlite": "cd node_modules/better-sqlite3 && node-gyp rebuild --release --target=$(node -p \"require('electron/package.json').version\") --dist-url=https://electronjs.org/headers --runtime=electron",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis:x64",
    "dist:win:nsis": "electron-builder --win nsis:x64",
    "dist:win:msi": "electron-builder --win msi:x64",
    "dist:win:all": "electron-builder --win nsis:x64 --win msi:x64",
    "release:win": "electron-builder --win nsis:x64",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "author": "Antigravity",
  "license": "ISC",
  "dependencies": {
    "active-win": "^8.2.1",
    "axios": "^1.6.0",
    "better-sqlite3": "11.3.0",
    "dotenv": "^16.3.1",
    "electron-store": "^8.1.0",
    "form-data": "^4.0.0",
    "jsonwebtoken": "^9.0.0",
    "luxon": "^3.4.0",
    "node-machine-id": "^1.1.12",
    "screenshot-desktop": "^1.15.0",
    "semver": "^7.7.3",
    "uiohook-napi": "^1.5.4",
    "uuid": "^9.0.1",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.usermonitor.agent",
    "productName": "User Monitor Agent",
    "asarUnpack": [
      "**/node_modules/screenshot-desktop/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "installerLanguages": ["en_US"],
      "shortcutName": "User Monitor Agent"
    },
    "msi": {
      "perMachine": false,
      "oneClick": false,
      "warningsAsErrors": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    }
  }
}
